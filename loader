function Load(scriptid)
	queue_on_teleport([[
		loadstring(game:HttpGet("https://raw.githubusercontent.com/idontknowwhattonamemyself/kikiisabadcoder/refs/heads/Lua/loader"))()
	]])
	script_key = getgenv().script_key
	getgenv().solara_script_key = script_key;
	loadstring(game:HttpGet("https://api.luarmor.net/files/v3/loaders/"..scriptid..".lua"))()
end
if getgenv().AutoLoadScript then 
	Load(getgenv().AutoLoadScript)
end


