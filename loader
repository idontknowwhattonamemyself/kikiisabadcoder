function TweenTransparency(component, length, endgoal)
    if component:IsA("ImageLabel") then
        ts:Create(component,TweenInfo.new(length, Enum.EasingStyle.Cubic),{ImageTransparency = endgoal}):Play()
    elseif component:IsA("CanvasGroup") then
        ts:Create(component,TweenInfo.new(length, Enum.EasingStyle.Cubic),{GroupTransparency = endgoal}):Play()
    elseif component:IsA("TextLabel") then
        ts:Create(component,TweenInfo.new(length, Enum.EasingStyle.Cubic),{TextTransparency = endgoal}):Play()
    else
        ts:Create(component,TweenInfo.new(length, Enum.EasingStyle.Cubic),{Transparency = endgoal}):Play()
    end	
end
